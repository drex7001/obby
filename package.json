{
  "private": true,
  "name": "gauntlet-run",
  "version": "1.0.0",
  "description": "A 3D multiplayer obstacle-course race built on Colyseus",
  "type": "module",
  "engines": {
    "node": ">= 22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
